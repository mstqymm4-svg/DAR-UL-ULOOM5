# ─────────────────────────────────────────────────────────────────────────────
# Dar Al Uloom — environment configuration
#
# LOCAL DEVELOPMENT (SQLite):   DATABASE_URL points at the local SQLite file.
#   cp .env.example .env   (then: npm install && npm run dev)
#
# PRODUCTION (PostgreSQL):     Render sets DATABASE_URL automatically from the
#   managed PostgreSQL database created by render.yaml. For any other host,
#   point DATABASE_URL at your own PostgreSQL server.
#   DATABASE_URL="postgresql://user:password@host:5432/dar_al_uloom"
#
# SECRETS: NEVER commit real values. Render generates JWT_SECRET for you and
#   asks you to type DEFAULT_ADMIN_PASSWORD during blueprint setup.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
# Local dev (SQLite):
DATABASE_URL="file:../../data/darul.sqlite"
# Production (PostgreSQL) — used by server/prisma/schema.prisma + migrations:
# DATABASE_URL="postgresql://user:password@host:5432/dar_al_uloom"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
# NODE_ENV=production   # uncomment for production-like behaviour (enforces JWT_SECRET)

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production (startup fails without it). Local dev falls back to a
# dev-only secret with a warning. Use a long random value.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
DEFAULT_ADMIN_USERNAME="admin"
# Seed-only: creates the admin account on first start if it does not exist.
DEFAULT_ADMIN_PASSWORD="ChangeMe123!"

# ─── Uploads / file storage ──────────────────────────────────────────────────
MAX_UPLOAD_MB=500
# Where uploaded files are stored. Defaults to <project>/server/uploads
# (Render mounts its persistent disk exactly there via render.yaml).
# UPLOADS_DIR=/opt/render/uploads

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for cross-origin browser requests.
# Same-origin deployments can leave this empty (no cross-origin access).
# CLIENT_ORIGIN=https://your-app.onrender.com,https://your-custom-domain.com
CLIENT_ORIGIN=
