# Local development defaults for the server (see the root .env.example for the
# full documentation). Copy to .env for local development:
#   cp .env.example .env
# Local dev uses SQLite. Production (Render) sets DATABASE_URL automatically.
DATABASE_URL="file:../../data/darul.sqlite"
PORT=4000
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="ChangeMe123!"
MAX_UPLOAD_MB=500
CLIENT_ORIGIN=
